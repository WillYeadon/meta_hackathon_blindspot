# No key => clearly labelled mock mode. Never put a key in browser code.
META_API_KEY=
META_MODEL=muse-spark-1.3
META_BASE_URL=https://api.meta.ai/v1
META_TEMPERATURE=1.0
META_REASONING_EFFORT=low
META_MAX_COMPLETION_TOKENS=4096
META_TIMEOUT_SECONDS=120
META_MAX_RETRIES=2
BLINDSPOT_TRIALS=5
BLINDSPOT_CONCURRENCY=3
BLINDSPOT_DB=var/blindspot.sqlite3
BLINDSPOT_MOCK=false
BLINDSPOT_SEED_DEMO=true
# Optional: load a trusted generated shortlist after running the search.
# BLINDSPOT_BANK=var/search/shortlist-bank.json
